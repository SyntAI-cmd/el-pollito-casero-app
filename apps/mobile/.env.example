# URL de la API. En Android fisico pone la IP de tu PC, por ejemplo http://192.168.0.10:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
# Clave de Google Maps para el mapa nativo de Android (Maps SDK for Android), restringida por
# package ar.com.pollitocasero.app + SHA-1. Solo hace falta para builds con EAS, no para Expo Go.
GOOGLE_MAPS_ANDROID_KEY=
